# =========================================================
# CyberGuard Mini SOAR - Environment Configuration Template
# Copy file này thành .env và điền các API Key / thông tin kết nối
# =========================================================

# CORS - Danh sách origin được phép (phân cách bằng dấu phẩy)
# Development: để trống (dùng default localhost)
# Production: điền đầy đủ domain của frontend
# ALLOWED_ORIGINS=https://soar.company.com,https://soc.company.com

# AI Tier-3 Triage Provider (gemini, openai, deepseek)
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_API_KEY=
DEFAULT_AI_MODEL=gemini-3.8-flash

# Threat Intelligence (VirusTotal v3 API)
VIRUSTOTAL_API_KEY=

# Wazuh SIEM / EDR Manager API
WAZUH_API_URL=https://192.168.56.101:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=

# Cloudflare WAF Connector
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Webhook Secret Authentication Key (thay bằng secret ngẫu nhiên trong production)
WEBHOOK_SECRET_KEY=cyberguard-soar-secret

# Linux SSH Connector (bắt buộc nếu dùng SSH password auth)
# Khuyến nghị: dùng SSH Key-based auth thay vì password
# LINUX_SSH_HOST=192.168.56.107
# LINUX_SSH_USER=minh
# LINUX_SSH_PASSWORD=
# LINUX_SSH_PORT=22
